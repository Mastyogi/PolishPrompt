{
  "buildCommand": "npm run build --force",
  "outputDirectory": "dist/client",
  "devCommand": "npm run dev",
  "framework": "tanstack-start",
  "functions": {
    "api/ssr.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/ssr"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "cache": false
}